# Copy this file to backend/.env and adjust for your machine.
# Demo defaults are fine for local evaluation.

ENVIRONMENT=development
SECRET_KEY=saraban-demo-secret-key-change-me-before-deploying-2026
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Absolute path by default (backend/saraban.db). Uncomment to override.
# DATABASE_URL=sqlite:///./saraban.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# Optional regex for extra allowed browser origins, e.g. Render static sites.
# CORS_ORIGIN_REGEX=https://.*\.onrender\.com

# Set to true on hosts with ephemeral SQLite storage (Render free tier) to
# restore the demo dataset automatically when the database is empty.
DEMO_SEED_ON_STARTUP=false
